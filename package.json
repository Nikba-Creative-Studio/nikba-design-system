{
  "name": "@nikba/design-system",
  "version": "1.0.0",
  "description": "Neutral interface foundations, Onest typography and performant glassmorphism by Nikba.",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "mcp",
    "src/tokens",
    "CHANGELOG.md"
  ],
  "bin": {
    "nikba-design-system-mcp": "mcp/server.js"
  },
  "main": "./dist/nikba-design-system.js",
  "module": "./dist/nikba-design-system.js",
  "style": "./dist/nikba-design-system.css",
  "exports": {
    ".": {
      "import": "./dist/nikba-design-system.js"
    },
    "./css": "./dist/nikba-design-system.css"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.js",
    "build": "npm run build:library && npm run build:catalog",
    "build:library": "vite build",
    "build:catalog": "vite build --config vite.playground.config.js",
    "build:pages": "vite build --config vite.playground.config.js --base=/nikba-design-system/",
    "preview": "vite preview --config vite.playground.config.js",
    "test:api": "node tests/api.test.mjs",
    "test:css": "node tests/css-contract.test.mjs",
    "test:contrast": "node tests/contrast.test.mjs",
    "test:mcp": "node tests/mcp.test.mjs",
    "test:accordion": "node tests/accordion.test.mjs",
    "test:tabs": "node tests/tabs.test.mjs",
    "test:dialog": "node tests/dialog.test.mjs",
    "test:popover": "node tests/popover.test.mjs",
    "test:select": "node tests/select.test.mjs",
    "test:tooltip": "node tests/tooltip.test.mjs",
    "test:toast": "node tests/toast.test.mjs",
    "test:navigation": "node tests/navigation.test.mjs",
    "test:table": "node tests/table.test.mjs",
    "test:form": "node tests/form.test.mjs",
    "test:consumer": "node tests/consumer-build.test.mjs",
    "test:blade": "node tests/blade-examples.test.mjs",
    "test:lifecycle": "node tests/dom-lifecycle.test.mjs",
    "test:filament": "node tests/filament-examples.test.mjs",
    "test:budgets": "node tests/budgets.test.mjs",
    "test:a11y": "node tests/catalog-accessibility.test.mjs",
    "test:browser": "node tests/browser-snapshots.test.mjs",
    "test:cross-browser": "node tests/cross-browser.test.mjs",
    "test:pages": "node tests/pages-build.test.mjs",
    "test": "npm run test:api && npm run test:css && npm run test:contrast && npm run test:budgets && npm run test:a11y && npm run test:accordion && npm run test:tabs && npm run test:dialog && npm run test:popover && npm run test:select && npm run test:tooltip && npm run test:toast && npm run test:navigation && npm run test:table && npm run test:form && npm run test:lifecycle && npm run test:mcp && npm run test:blade && npm run test:filament && npm run test:examples",
    "mcp": "node ./mcp/server.js",
    "verify": "npm run build && npm test && npm run test:consumer && npm pack --dry-run",
    "test:release": "node scripts/check-release.mjs",
    "verify:release": "npm run verify && npm run test:release && npm audit --omit=dev --audit-level=high",
    "examples:generate": "node scripts/variant-examples.mjs && node scripts/catalog-examples.mjs",
    "test:examples": "node scripts/variant-examples.mjs --check && node scripts/catalog-examples.mjs --check"
  },
  "keywords": [
    "design-system",
    "glassmorphism",
    "onest",
    "css",
    "laravel"
  ],
  "author": "Nikba Creative Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikba-Creative-Studio/nikba-design-system.git"
  },
  "homepage": "https://nikba-creative-studio.github.io/nikba-design-system/",
  "bugs": {
    "url": "https://github.com/Nikba-Creative-Studio/nikba-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "parse5": "^8.1.1",
    "playwright": "^1.65.0",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  }
}
