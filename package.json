{
  "name": "@nikba/design-system",
  "version": "0.1.0-alpha.1",
  "description": "Neutral interface foundations, Onest typography and performant glassmorphism by Nikba.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/nikba-design-system.js",
  "module": "./dist/nikba-design-system.js",
  "style": "./dist/nikba-design-system.css",
  "exports": {
    ".": {
      "import": "./dist/nikba-design-system.js"
    },
    "./css": "./dist/nikba-design-system.css"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.js",
    "build": "npm run build:library && npm run build:catalog",
    "build:library": "vite build",
    "build:catalog": "vite build --config vite.playground.config.js",
    "preview": "vite preview --config vite.playground.config.js",
    "test:api": "node tests/api.test.mjs",
    "test:css": "node tests/css-contract.test.mjs",
    "test:contrast": "node tests/contrast.test.mjs",
    "test": "npm run test:api && npm run test:css && npm run test:contrast",
    "verify": "npm run build && npm test && npm pack --dry-run"
  },
  "keywords": [
    "design-system",
    "glassmorphism",
    "onest",
    "css",
    "laravel"
  ],
  "author": "Nikba Creative Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikba-Creative-Studio/nikba-design-system.git"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
