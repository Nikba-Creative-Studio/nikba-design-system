{
  "schemaVersion": 1,
  "web": {
    "primitive": [
      {
        "selector": ":root",
        "declarations": {
          "--nds-font-sans": "'Onest', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "--nds-font-weight-regular": "400",
          "--nds-font-weight-medium": "500",
          "--nds-font-weight-semibold": "600",
          "--nds-font-weight-bold": "700",
          "--nds-font-size-xs": "0.75rem",
          "--nds-font-size-sm": "0.875rem",
          "--nds-font-size-md": "0.9375rem",
          "--nds-font-size-base": "1rem",
          "--nds-font-size-lg": "1.125rem",
          "--nds-font-size-xl": "1.25rem",
          "--nds-font-size-heading-3": "clamp(1.25rem, 2vw, 1.75rem)",
          "--nds-font-size-heading-2": "clamp(1.75rem, 3vw, 2.75rem)",
          "--nds-font-size-heading-1": "clamp(2.25rem, 5vw, 4.75rem)",
          "--nds-font-size-display": "clamp(3.5rem, 8vw, 7.5rem)",
          "--nds-line-height-tight": "0.94",
          "--nds-line-height-heading": "1.05",
          "--nds-line-height-control": "1",
          "--nds-line-height-body": "1.65",
          "--nds-letter-spacing-display": "-0.055em",
          "--nds-letter-spacing-heading": "-0.035em",
          "--nds-letter-spacing-body": "-0.006em",
          "--nds-letter-spacing-label": "0.08em",
          "--nds-space-0": "0",
          "--nds-space-1": "0.25rem",
          "--nds-space-2": "0.5rem",
          "--nds-space-3": "0.75rem",
          "--nds-space-4": "1rem",
          "--nds-space-5": "1.5rem",
          "--nds-space-6": "2rem",
          "--nds-space-7": "3rem",
          "--nds-space-8": "4rem",
          "--nds-space-9": "6rem",
          "--nds-space-10": "9rem",
          "--nds-control-height-sm": "2.25rem",
          "--nds-control-height-md": "2.75rem",
          "--nds-control-height-lg": "3rem",
          "--nds-control-height-xl": "3.25rem",
          "--nds-radius-none": "0",
          "--nds-radius-sm": "0.75rem",
          "--nds-radius-md": "1rem",
          "--nds-radius-lg": "1.75rem",
          "--nds-radius-xl": "2.25rem",
          "--nds-radius-pill": "999px",
          "--nds-border-width": "1px",
          "--nds-border-width-strong": "2px",
          "--nds-opacity-disabled": "0.42",
          "--nds-opacity-muted": "0.68",
          "--nds-duration-instant": "0ms",
          "--nds-duration-fast": "180ms",
          "--nds-duration-normal": "260ms",
          "--nds-duration-slow": "650ms",
          "--nds-ease-standard": "ease",
          "--nds-ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
          "--nds-breakpoint-mobile": "43.75rem",
          "--nds-breakpoint-tablet": "68.75rem",
          "--nds-z-base": "0",
          "--nds-z-dropdown": "100",
          "--nds-z-sticky": "200",
          "--nds-z-tooltip": "300",
          "--nds-z-overlay": "400",
          "--nds-z-modal": "500",
          "--nds-z-toast": "600",
          "--nds-container-max": "80rem",
          "--nds-prose-max": "47.5rem"
        }
      }
    ],
    "themes": [
      {
        "selector": ":root,\n[data-theme='frost']",
        "declarations": {
          "color-scheme": "light",
          "--nds-color-canvas": "#f5f5f3",
          "--nds-color-surface": "#ffffff",
          "--nds-color-surface-alt": "#ececea",
          "--nds-color-surface-hover": "#f9f9f8",
          "--nds-color-glass": "rgba(255, 255, 255, 0.68)",
          "--nds-color-glass-strong": "rgba(255, 255, 255, 0.84)",
          "--nds-color-border": "#d9d9d5",
          "--nds-color-border-hover": "#b8b8b2",
          "--nds-color-text": "#171716",
          "--nds-color-text-secondary": "#5f5f5a",
          "--nds-color-text-tertiary": "#74746e",
          "--nds-color-text-inverse": "#ffffff",
          "--nds-color-accent": "#20211f",
          "--nds-color-accent-hover": "#3a3b38",
          "--nds-color-focus": "#667085",
          "--nds-color-success": "#237a57",
          "--nds-color-warning": "#956b20",
          "--nds-color-danger": "#b43b3b",
          "--nds-color-danger-hover": "#963131",
          "--nds-color-info": "#496a86",
          "--nds-elevation-subtle": "0 1px 2px rgba(23, 23, 22, 0.05), 0 8px 30px rgba(23, 23, 22, 0.04)",
          "--nds-elevation-raised": "0 18px 54px rgba(23, 23, 22, 0.13)",
          "--nds-glass-highlight": "inset 0 1px 0 rgba(255, 255, 255, 0.72)"
        }
      },
      {
        "selector": "[data-theme='mist']",
        "declarations": {
          "color-scheme": "light",
          "--nds-color-canvas": "#e9e9e5",
          "--nds-color-surface": "#f4f4f1",
          "--nds-color-surface-alt": "#deded9",
          "--nds-color-surface-hover": "#fafaf7",
          "--nds-color-glass": "rgba(246, 246, 242, 0.62)",
          "--nds-color-glass-strong": "rgba(246, 246, 242, 0.8)",
          "--nds-color-border": "#cbcbc5",
          "--nds-color-border-hover": "#aaa9a2",
          "--nds-color-text": "#1c1d1b",
          "--nds-color-text-secondary": "#5c5d58",
          "--nds-color-text-tertiary": "#6f706a",
          "--nds-color-text-inverse": "#ffffff",
          "--nds-color-accent": "#292b28",
          "--nds-color-accent-hover": "#444640",
          "--nds-color-focus": "#69716b",
          "--nds-color-success": "#237a57",
          "--nds-color-warning": "#8b6728",
          "--nds-color-danger": "#a83e3e",
          "--nds-color-danger-hover": "#8e3434",
          "--nds-color-info": "#4b6b7c",
          "--nds-elevation-subtle": "0 1px 2px rgba(28, 29, 27, 0.06), 0 10px 32px rgba(28, 29, 27, 0.06)",
          "--nds-elevation-raised": "0 18px 54px rgba(28, 29, 27, 0.14)",
          "--nds-glass-highlight": "inset 0 1px 0 rgba(255, 255, 255, 0.62)"
        }
      },
      {
        "selector": "[data-theme='graphite']",
        "declarations": {
          "color-scheme": "dark",
          "--nds-color-canvas": "#111210",
          "--nds-color-surface": "#1a1b19",
          "--nds-color-surface-alt": "#222320",
          "--nds-color-surface-hover": "#292a27",
          "--nds-color-glass": "rgba(31, 32, 29, 0.62)",
          "--nds-color-glass-strong": "rgba(31, 32, 29, 0.82)",
          "--nds-color-border": "#343632",
          "--nds-color-border-hover": "#555851",
          "--nds-color-text": "#f2f2ee",
          "--nds-color-text-secondary": "#b4b5ae",
          "--nds-color-text-tertiary": "#85877f",
          "--nds-color-text-inverse": "#161714",
          "--nds-color-accent": "#eeeee9",
          "--nds-color-accent-hover": "#d4d5ce",
          "--nds-color-focus": "#a6ada7",
          "--nds-color-success": "#65b68e",
          "--nds-color-warning": "#d3ac63",
          "--nds-color-danger": "#e27a7a",
          "--nds-color-danger-hover": "#f08d8d",
          "--nds-color-info": "#8db6d2",
          "--nds-elevation-subtle": "0 1px 2px rgba(0, 0, 0, 0.18), 0 10px 34px rgba(0, 0, 0, 0.16)",
          "--nds-elevation-raised": "0 20px 60px rgba(0, 0, 0, 0.32)",
          "--nds-glass-highlight": "inset 0 1px 0 rgba(255, 255, 255, 0.1)"
        }
      },
      {
        "selector": ":root,\n[data-glass='soft']",
        "declarations": {
          "--nds-glass-blur": "8px",
          "--nds-glass-opacity": "100%",
          "--nds-glass-filter": "blur(var(--nds-glass-blur)) saturate(120%)"
        }
      },
      {
        "selector": "[data-glass='off']",
        "declarations": {
          "--nds-glass-blur": "0px",
          "--nds-glass-opacity": "100%",
          "--nds-glass-filter": "none"
        }
      },
      {
        "selector": "[data-glass='clear']",
        "declarations": {
          "--nds-glass-blur": "14px",
          "--nds-glass-opacity": "78%",
          "--nds-glass-filter": "blur(var(--nds-glass-blur)) saturate(120%)"
        }
      }
    ],
    "semantic": [
      {
        "selector": ":root",
        "declarations": {
          "--nds-bg": "var(--nds-color-canvas)",
          "--nds-surface": "var(--nds-color-surface)",
          "--nds-surface-alt": "var(--nds-color-surface-alt)",
          "--nds-surface-hover": "var(--nds-color-surface-hover)",
          "--nds-glass": "var(--nds-color-glass)",
          "--nds-glass-strong": "var(--nds-color-glass-strong)",
          "--nds-border": "var(--nds-color-border)",
          "--nds-border-hover": "var(--nds-color-border-hover)",
          "--nds-text": "var(--nds-color-text)",
          "--nds-text-secondary": "var(--nds-color-text-secondary)",
          "--nds-text-tertiary": "var(--nds-color-text-tertiary)",
          "--nds-text-inverse": "var(--nds-color-text-inverse)",
          "--nds-accent": "var(--nds-color-accent)",
          "--nds-accent-hover": "var(--nds-color-accent-hover)",
          "--nds-focus": "var(--nds-color-focus)",
          "--nds-success": "var(--nds-color-success)",
          "--nds-warning": "var(--nds-color-warning)",
          "--nds-danger": "var(--nds-color-danger)",
          "--nds-danger-hover": "var(--nds-color-danger-hover)",
          "--nds-info": "var(--nds-color-info)",
          "--nds-shadow-subtle": "var(--nds-elevation-subtle)",
          "--nds-shadow-elevated": "var(--nds-elevation-raised)",
          "--nds-focus-ring-width": "3px",
          "--nds-focus-ring-offset": "3px",
          "--nds-disabled-opacity": "var(--nds-opacity-disabled)",
          "--nds-page-gutter": "clamp(1.25rem, 4vw, 4rem)",
          "--nds-section-space": "clamp(5rem, 12vw, 10rem)",
          "--nds-component-gap": "clamp(1rem, 2vw, 2rem)",
          "--nds-card-padding": "clamp(1.25rem, 3vw, 2.5rem)",
          "--nds-link-underline-offset": "0.22em",
          "--nds-link-underline-thickness": "1px"
        }
      }
    ]
  }
}
